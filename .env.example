# ───────────────────────────────────────────────────────────────
# Castbridge – Beispielkonfiguration
# Kopiere diese Datei nach .env und fülle die Werte aus.
# Pflichtfelder sind markiert. Alles andere hat sinnvolle Vorgaben.
# ───────────────────────────────────────────────────────────────

# PFLICHT: Öffentliche Adresse der Web-App (ohne Schrägstrich am Ende)
PUBLIC_URL=https://stream.example.de

# PFLICHT: Hostname/IP, an die OBS sendet (meist dieselbe Maschine)
INGEST_HOST=stream.example.de
INGEST_RTMP_PORT=1935
INGEST_SRT_PORT=8890

# PFLICHT: Zufallsgeheimnisse. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEY=
SESSION_SECRET=

# PFLICHT: Datenbank
DATABASE_URL=postgres://castbridge:castbridge@postgres:5432/castbridge

# Optional. Ohne Redis läuft alles in einem Prozess (für 1 Server völlig ok).
REDIS_URL=redis://redis:6379

# Erster Admin-Zugang. Wird beim ersten Start einmalig angelegt.
ADMIN_EMAIL=admin@example.de
ADMIN_PASSWORD=bitte-aendern

# MediaMTX (Ingest). Vorgaben passen zum mitgelieferten docker-compose.
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_RTMP_URL=rtmp://mediamtx:1935
MEDIAMTX_INGEST_PATH_PREFIX=live

# Plattform-Apps (siehe docs/SETUP.md). Leer lassen = nur manuelle Keys.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Betrieb
PORT=3000
DATA_DIR=/data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_CONCURRENT_STREAMS=3
LOG_LEVEL=info

# Warnschwellen
TWITCH_MAX_BITRATE_KBPS=6000
